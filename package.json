{
    "name": "inventory-control-api",
    "version": "2.0.0",
    "description": "Inventory Control API with per-warehouse stock, transfers, reservations, and procurement",
    "main": "server.js",
    "type": "module",
    "packageManager": "pnpm@10.19.0",
    "scripts": {
        "dev": "node --env-file=.env --watch src/server.js",
        "start": "node --env-file-if-exists=.env src/server.js",
        "migrate": "node-pg-migrate up --migrations-dir src/database/migrations",
        "test": "vitest run",
        "test:unit": "vitest run --config vitest.config.js tests/unit/",
        "test:integration": "vitest run --config vitest.config.js tests/integration/",
        "test:e2e": "vitest run --config vitest.config.js tests/e2e/",
        "lint": "prettier . --check",
        "lint:format": "prettier . --write"
    },
    "dependencies": {
        "argon2": "^0.45.1",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "node-pg-migrate": "^9.0.0",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3"
    },
    "devDependencies": {
        "@types/pg": "^8.20.0",
        "dotenv": "^17.4.2",
        "globals": "^17.7.0",
        "prettier": "3.9.6",
        "supertest": "^7.2.2",
        "vitest": "^4.1.10"
    },
    "license": "MIT",
    "pnpm": {
        "onlyBuiltDependencies": [
            "argon2"
        ]
    }
}
